# Copie para .env.local e preencha. Nenhuma destas variáveis é obrigatória
# para o build: sem projeto Sanity configurado, o site builda e o /studio
# mostra "Sanity não configurado".

# ID do projeto Sanity (painel sanity.io > projeto > Settings). Público.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset do Sanity. Público. Padrão: production.
NEXT_PUBLIC_SANITY_DATASET=production

# Token de leitura (Viewer) do Sanity. Só é necessário para ler conteúdo
# em rascunho ou dataset privado. Vazio em produção pública. Servidor apenas.
SANITY_API_READ_TOKEN=

# Segredo compartilhado com o webhook do Sanity que chama /api/revalidate.
# Gere um valor aleatório longo e use o mesmo no painel do Sanity. Servidor apenas.
SANITY_REVALIDATE_SECRET=
